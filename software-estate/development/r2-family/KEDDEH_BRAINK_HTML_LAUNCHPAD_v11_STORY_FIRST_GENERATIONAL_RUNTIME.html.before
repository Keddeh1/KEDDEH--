<article class="card span12"><h3>Persistent Work Queue</h3><div class="controls"><button id="genRun">Run ready generation</button><button id="genContinue">Continue admissible work</button><button id="genExport">Export checkpoint</button></div><table><thead><tr><th>Task</th><th>Team</th><th>Dependency</th><th>Status</th><th>Receipt</th></tr></thead><tbody id="genTasks"></tbody></table></article>
