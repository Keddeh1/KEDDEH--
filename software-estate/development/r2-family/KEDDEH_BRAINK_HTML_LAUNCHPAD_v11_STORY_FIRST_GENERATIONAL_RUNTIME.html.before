<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>V8 Evidence-Bearing — KEDDEH BRAINK Launchpad · BTC Core Resident Envelope</title>
<style>
:root{
  --bg:#07111f;--panel:#0b1829;--panel2:#0e2036;--line:#213753;--text:#eaf2ff;
  --muted:#9fb3ca;--accent:#8db8ff;--ok:#75d39a;--warn:#f1c86a;--bad:#ff8a8a;
  --radius:12px;--gap:12px;
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
body{min-height:100vh}
button,input,select{font:inherit}
button{cursor:pointer}
header{position:sticky;top:0;z-index:20;background:rgba(7,17,31,.96);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.wrap{max-width:1600px;margin:auto;padding:18px 22px}
.top{display:flex;align-items:center;gap:14px;justify-content:space-between}
.brand h1{font-size:20px;margin:0}.brand p{margin:4px 0 0;color:var(--muted);font-size:12px}
.badges{display:flex;gap:8px;flex-wrap:wrap}
.badge{padding:5px 8px;border:1px solid var(--line);border-radius:999px;font:600 11px ui-monospace,SFMono-Regular,Menlo,monospace}
.ok{color:var(--ok)}.warn{color:var(--warn)}.bad{color:var(--bad)}
.layout{display:grid;grid-template-columns:240px minmax(0,1fr);gap:16px}
nav{position:sticky;top:86px;align-self:start}
nav button{display:block;width:100%;text-align:left;background:transparent;color:var(--muted);border:1px solid transparent;border-radius:8px;padding:9px 10px;margin:2px 0}
nav button.active,nav button:hover{background:var(--panel);color:var(--text);border-color:var(--line)}
main{min-width:0}
section{display:none}section.active{display:block}
h2{font-size:18px;margin:0 0 12px}h3{font-size:13px;margin:0 0 8px;color:var(--accent);text-transform:uppercase;letter-spacing:.07em}
.grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--gap)}
.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:14px;min-width:0}
.span4{grid-column:span 4}.span6{grid-column:span 6}.span8{grid-column:span 8}.span12{grid-column:1/-1}
.metric{font:700 23px ui-monospace,SFMono-Regular,Menlo,monospace}.label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.kv{display:grid;grid-template-columns:minmax(140px,.7fr) minmax(0,1.3fr);gap:6px 12px;font:12px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace}
.kv div:nth-child(odd){color:var(--muted)}
.pipeline{display:flex;gap:7px;flex-wrap:wrap}.stage{padding:7px 9px;border:1px solid var(--line);border-radius:8px;font:600 11px ui-monospace,SFMono-Regular,Menlo,monospace}
.stage.pass{border-color:#2d6e4d;color:var(--ok)}.stage.open{border-color:#6e5e2d;color:var(--warn)}.stage.blocked{border-color:#6e3434;color:var(--bad)}
.controls{display:flex;gap:8px;flex-wrap:wrap}.controls button{background:var(--panel2);border:1px solid var(--line);color:var(--text);padding:8px 10px;border-radius:8px}
.controls button.primary{border-color:#416a9a}
pre{white-space:pre-wrap;word-break:break-word;background:#081421;border:1px solid var(--line);border-radius:8px;padding:10px;color:#cfe0f4;font:11px/1.55 ui-monospace,SFMono-Regular,Menlo,monospace;max-height:420px;overflow:auto}
table{width:100%;border-collapse:collapse;font-size:12px}th,td{padding:8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{color:var(--accent)}
input,select{background:#081421;border:1px solid var(--line);color:var(--text);padding:8px;border-radius:7px;width:100%}
.note{color:var(--muted);font-size:12px;line-height:1.5}
footer{color:var(--muted);font-size:11px;padding:18px 0}
@media(max-width:980px){.layout{grid-template-columns:1fr}nav{position:static;display:flex;overflow:auto;gap:5px}nav button{white-space:nowrap;width:auto}.span4,.span6,.span8{grid-column:1/-1}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style>
</head>
<body>
<header>
  <div class="wrap top">
    <div class="brand">
      <h1>KEDDEH BRAINK Launchpad</h1>
      <p>HTML authority surface · resident runtime projection · BTC Core node/server envelope</p>
    </div>
    <div class="badges">
      <span class="badge ok">HTML SURFACE: READY</span>
      <span class="badge warn" id="runtimeBadge">RUNTIME: UNBOUND</span>
      <span class="badge warn" id="coreBadge">BTC CORE: UNOBSERVED</span>
    </div>
  </div>
</header>

<div class="wrap layout">
<nav aria-label="Launchpad sections">
  <button class="active" data-target="overview">Overview</button>
  <button data-target="btc">BTC Protocol</button>
  <button data-target="linux">Resident Linux</button>
  <button data-target="node">Bitcoin Core Node</button>
  <button data-target="runtime">Runtime & Adapters</button>
  <button data-target="skills">Skill Fabric</button>
  <button data-target="evidence">Evidence & Failures</button>
  <button data-target="storage">Storage & GitHub</button>
  <button data-target="settings">Authority & Safety</button>
</nav>

<main>
<section id="overview" class="active">
  <h2>System Overview</h2>
  <div class="grid">
    <article class="card span4"><div class="label">Launch Authority</div><div class="metric">HTML</div><p class="note">The launchpad owns interaction, state visibility, routing intent and evidence projection.</p></article>
    <article class="card span4"><div class="label">Resident Execution</div><div class="metric">ADAPTER-BOUND</div><p class="note">Python/host processes are execution manifestations, not UI authority.</p></article>
    <article class="card span4"><div class="label">Repository Role</div><div class="metric">STORAGE</div><p class="note">GitHub stores/version-controls artifacts; it does not define product state.</p></article>

    <article class="card span12">
      <h3>Primary Causal Route</h3>
      <div class="pipeline">
        <span class="stage pass">HTML LAUNCHPAD</span>
        <span class="stage open">RESIDENT BRIDGE</span>
        <span class="stage open">BITCOIN CORE</span>
        <span class="stage open">GETBLOCKTEMPLATE</span>
        <span class="stage open">CANDIDATE</span>
        <span class="stage open">SHA256D</span>
        <span class="stage open">RECONSTRUCT</span>
        <span class="stage open">SUBMITBLOCK</span>
        <span class="stage open">CHAIN</span>
        <span class="stage open">MATURITY</span>
      </div>
    </article>

    <article class="card span6"><h3>State Ownership</h3><div class="kv">
      <div>UI / navigation</div><div>HTML launchpad</div>
      <div>BTC protocol truth</div><div>Bitcoin Core + consensus rules</div>
      <div>Execution</div><div>Resident HTML Linux / V86 first; host adapters only where required</div>
      <div>Evidence</div><div>Receipt ledger + immutable exported artifacts</div>
      <div>Storage</div><div>Local Library / Drive / GitHub version storage</div>
    </div></article>

    <article class="card span6"><h3>Current Boundary</h3><p class="note">This HTML file is a self-contained control surface. It does not claim to run <code>bitcoind</code> inside the browser. When bound to the resident bridge it becomes the operator console for the node server, mining runtime, evidence ledger and skill-governed workflows.</p></article>
  </div>
</section>

<section id="btc">
  <h2>BTC Protocol Domain</h2>
  <div class="grid">
    <article class="card span12"><h3>Canonical Mining State Machine</h3>
      <div class="pipeline" id="btcPipeline"></div>
    </article>
    <article class="card span6"><h3>Candidate Integrity</h3><div class="kv" id="candidateKv"></div></article>
    <article class="card span6"><h3>Mining Controls</h3>
      <div class="controls">
        <button data-system-action="REQUEST_TEMPLATE">Request template</button>
        <button data-system-action="RUN_VERTICAL_CLOSURE">Run vertical closure</button>
        <button data-system-action="START_HASHING">Start hashing</button>
        <button data-system-action="STOP_HASHING">Stop hashing</button>
        <button class="primary" data-system-action="SUBMIT_BLOCK">Submit qualified block</button>
      </div>
      <p class="note">Submission remains fail-closed. A target hit is required; a non-hit is a valid mining result, not a build failure.</p>
    </article>
  </div>
</section>


<section id="linux">
  <h2>Resident Linux Execution Substrate</h2>
  <div class="grid">
    <article class="card span4">
      <div class="label">Linux Carrier</div>
      <div class="metric" id="linuxCarrierState">UNRESOLVED</div>
      <p class="note">V86-backed Linux is treated as a package-local execution manifestation inside the HTML volume.</p>
    </article>
    <article class="card span4">
      <div class="label">Volume State</div>
      <div class="metric" id="linuxVolumeState">UNOBSERVED</div>
      <p class="note">Kernel/initrd/BIOS/runtime assets resolve to package-local volume paths when resident assets are present.</p>
    </article>
    <article class="card span4">
      <div class="label">Bitcoin Core Payload</div>
      <div class="metric" id="corePayloadState">NOT STORED</div>
      <p class="note">After first verified acquisition, the release can be persisted in the resident volume and reused on later launches.</p>
    </article>

    <article class="card span6">
      <h3>Resident Linux Asset Map</h3>
      <div class="kv">
        <div>V86 WASM</div><div><code>/volume/v86.wasm</code></div>
        <div>BIOS</div><div><code>/volume/seabios.bin</code></div>
        <div>VGA BIOS</div><div><code>/volume/vgabios.bin</code></div>
        <div>Kernel</div><div><code>/volume/bzimage-linux.bin</code></div>
        <div>Initrd</div><div><code>/volume/buildroot-linux.bin</code></div>
        <div>Guest root</div><div><code>/linux_guest/rootfs</code></div>
        <div>Shell</div><div><code>/linux_guest/rootfs/bin/kex-sh</code></div>
      </div>
    </article>

    <article class="card span6">
      <h3>Linux Controls</h3>
      <div class="controls">
        <button data-resident-action="LINUX_BOOT">Boot Linux</button>
        <button data-resident-action="LINUX_STATUS">Read status</button>
        <button data-resident-action="LINUX_MOUNT_VOLUME">Mount resident volume</button>
        <button data-resident-action="LINUX_REHYDRATE">Rehydrate state</button>
        <button data-resident-action="LINUX_OPEN_SHELL">Open shell</button>
      </div>
      <p class="note">These controls first target resident in-HTML capability. A host bridge is fallback only when the HTML carrier does not expose the required operation.</p>
    </article>

    <article class="card span12">
      <h3>Bitcoin Core Resident Payload Lifecycle</h3>
      <div class="pipeline">
        <span class="stage open">DOWNLOAD ONCE</span>
        <span class="stage open">VERIFY SHA256</span>
        <span class="stage open">VERIFY SIGNERS</span>
        <span class="stage open">STORE IN VOLUME</span>
        <span class="stage open">HASH + MANIFEST</span>
        <span class="stage open">REHYDRATE</span>
        <span class="stage open">EXECUTE IN LINUX</span>
        <span class="stage open">BITCOIND</span>
        <span class="stage open">RPC</span>
      </div>
      <p class="note">Once a Bitcoin Core payload has a retained release hash, manifest hash, signature receipt and resident-volume address, later boots should rehydrate the stored payload instead of downloading it again.</p>
    </article>


    
    <article class="card span12">
      <h3>Linux Dependency Graph</h3>
      <table>
        <thead><tr><th>Requirement</th><th>Resolved Source</th><th>State</th><th>Gate</th></tr></thead>
        <tbody id="linuxDependencyBody"></tbody>
      </table>
      <div class="controls">
        <button id="linuxResolveDeps">Resolve / Rehydrate Dependencies</button>
        <button id="linuxRealBoot" disabled>Boot Real V86 Linux</button>
      </div>
      <p class="note">RUNNING is promoted only after a real <code>emulator-ready</code> event. Assets are persisted in IndexedDB after first successful acquisition and rehydrated locally on later launches.</p>
    </article>

    <article class="card span8">
      <h3>V86 Linux Screen</h3>
      <div id="screen_container" style="min-height:420px;background:#000;border:1px solid var(--line);border-radius:8px;overflow:hidden"></div>
    </article>

    <article class="card span4">
      <h3>TTY1 / Serial0</h3>
      <pre id="terminal-output" style="height:330px;max-height:330px"></pre>
      <input id="terminal-input" placeholder="type command then Enter" aria-label="Linux serial terminal input">
    </article>

<article class="card span12" id="residentShellCard">
      <h3>Resident Shell / Action Readback</h3>
      <div class="controls">
        <input id="residentShellInput" value="status" aria-label="Resident shell command" style="max-width:420px">
        <button id="residentShellRun">Run command</button>
      </div>
      <pre id="residentShellOutput">Linux worker ready. Commands: status, ps, mounts, syscalls, proof, help</pre>
    </article>

    <article class="card span12">
      <h3>Resident Volume Record</h3>
      <pre id="residentVolumeRecord">{
  "address": "kex://volume/btc-core/31.1",
  "release": "31.1",
  "artifact": null,
  "artifact_sha256": null,
  "sha256sums_sha256": null,
  "signature_receipt": null,
  "trusted_fingerprints": [],
  "storage_state": "EMPTY",
  "rehydration_state": "NOT_ATTEMPTED",
  "execution_state": "NOT_STARTED"
}</pre>
    </article>
  </div>
</section>

<section id="node">
  <h2>Bitcoin Core Node / Server</h2>
  <div class="grid">
    <article class="card span4"><div class="label">Node State</div><div class="metric" id="nodeState">UNOBSERVED</div></article>
    <article class="card span4"><div class="label">Chain</div><div class="metric" id="chainState">—</div></article>
    <article class="card span4"><div class="label">Verification</div><div class="metric" id="verifyState">—</div></article>

    <article class="card span6"><h3>Node Lifecycle</h3>
      <div class="controls">
        <button data-system-action="CHECK_RPC">Check RPC</button>
        <button data-system-action="START_NODE">Start node</button>
        <button data-system-action="STOP_NODE">Stop node</button>
        <button data-system-action="GET_BLOCKCHAIN_INFO">Refresh chain state</button>
      </div>
      <p class="note">The launchpad governs a resident Bitcoin Core instance through the adapter. Cookie/RPC credentials remain host-side and are never embedded into this HTML.</p>
    </article>

    <article class="card span6"><h3>Node Authority</h3><div class="kv">
      <div>RPC host</div><div id="rpcHost">127.0.0.1 / unresolved</div>
      <div>Network</div><div id="network">mainnet / unresolved</div>
      <div>Datadir</div><div id="datadir">resident host only</div>
      <div>Initial block download</div><div id="ibd">unknown</div>
      <div>Best block</div><div id="bestBlock">unknown</div>
      <div>Template authority</div><div id="templateAuthority">unobserved</div>
    </div></article>

    <article class="card span12"><h3>Server Topology</h3><pre>HTML Launchpad
   │
   ├── Resident Linux / V86
   │     ├── /volume/v86.wasm
   │     ├── /volume/bzimage-linux.bin
   │     ├── /volume/buildroot-linux.bin
   │     └── kex://volume/btc-core/31.1
   │
   ├── resident://node/check
   ├── resident://node/start
   ├── resident://node/stop
   ├── resident://rpc/getblockchaininfo
   ├── resident://rpc/getbestblockhash
   ├── resident://rpc/getblocktemplate
   │
   └── Resident BTC Runtime
         ├── btc_workload_substrate.py
         ├── btc_consensus.py
         ├── btc_vertical_closure.py
         ├── solver / SHA256d workers
         └── Bitcoin Core bitcoind :8332 (mainnet RPC)</pre></article>
  </div>
</section>

<section id="runtime">
  <h2>Runtime & Adapter Plane</h2>
  <div class="grid">
    <article class="card span6"><h3>Resident Invocation Contract</h3>
      <pre id="bridgeContract">resident://dispatch
{
  "command": "CHECK_RPC | START_NODE | REQUEST_TEMPLATE | RUN_VERTICAL_CLOSURE | START_HASHING | STOP_HASHING | SUBMIT_BLOCK",
  "seed": "KEX-HTML-LAUNCHPAD-20260819-7F2C91",
  "authority": "operator"
}</pre>
    </article>
    <article class="card span6"><h3>Readback Contract</h3>
      <pre>{
  "runtime": {...},
  "node": {...},
  "template": {...},
  "candidate": {...},
  "submission": {...},
  "evidence": [...],
  "failures": [...]
}</pre>
    </article>
    <article class="card span12"><h3>Runtime Log</h3><pre id="log">Launchpad initialized in UNBOUND mode.
No external call is made until a resident bridge is explicitly configured.</pre></article>
  </div>
</section>

<section id="skills">
  <h2>Skill Fabric</h2>
  <div class="grid">
    <article class="card span12"><table>
      <thead><tr><th>Skill / Mechanic</th><th>Launchpad Application</th></tr></thead>
      <tbody id="skillsBody"></tbody>
    </table></article>
  </div>
</section>

<section id="evidence">
  <h2>Evidence & Failure Lineage</h2>
  <div class="grid">
    <article class="card span6"><h3>Evidence Classes</h3><div class="kv">
      <div>DECLARED</div><div>Named intent or configuration only</div>
      <div>SOURCE_VERIFIED</div><div>Implementation inspected</div>
      <div>TESTED</div><div>Repeatable execution receipt exists</div>
      <div>EMPIRICALLY_VERIFIED</div><div>Observed live system property</div>
      <div>PROVEN</div><div>Only property-scoped formal proof</div>
    </div></article>
    <article class="card span6"><h3>BTC Failure Classes</h3><div class="kv">
      <div>F-A</div><div>Wrong / incomplete Bitcoin workload</div>
      <div>F-B</div><div>Synthetic authority contamination</div>
      <div>F-C</div><div>Submission-state conflation</div>
      <div>F-D</div><div>Evidence-category conflation</div>
      <div>F-E</div><div>Context / integration regression</div>
      <div>F-F</div><div>Horizontal expansion before vertical closure</div>
    </div></article>
    <article class="card span12"><h3>Receipt Stream</h3><pre id="receipts">No runtime receipts loaded.</pre></article>
  </div>
</section>

<section id="storage">
  <h2>Storage, Library & GitHub</h2>
  <div class="grid">
    <article class="card span4"><h3>GitHub</h3><p class="note">Versioned source/storage facility. Branches and CI are development evidence, not product authority.</p></article>
    <article class="card span4"><h3>Library / Drive</h3><p class="note">Persistent literal artifacts, receipts, reports, HTML launch surfaces, ledgers and research assets.</p></article>
    <article class="card span4"><h3>Resident State</h3><p class="note">Node datadir, RPC cookie, templates, candidate files, submission ledger, runtime logs and operational state remain host-side.</p></article>
  </div>
</section>

<section id="settings">
  <h2>Authority & Safety</h2>
  <div class="grid">
    <article class="card span6"><h3>Bridge Endpoint</h3>
      <label class="label" for="endpoint">Resident bridge URL</label>
      <input id="endpoint" value="http://127.0.0.1:8799/bridge/command" aria-describedby="endpointHelp">
      <p class="note" id="endpointHelp">Local by default. No credentials are stored in the HTML.</p>
      <div class="controls"><button data-ui-action="BIND_RUNTIME">Bind runtime</button><button data-ui-action="UNBIND_RUNTIME">Unbind</button></div>
    </article>
    <article class="card span6"><h3>Execution Policy</h3>
      <div class="kv">
        <div>Mainnet fallback</div><div class="bad">FORBIDDEN</div>
        <div>Live submit</div><div>Requires runtime gate + target hit</div>
        <div>Secrets in browser</div><div class="bad">FORBIDDEN</div>
        <div>Evidence downgrade</div><div class="bad">FORBIDDEN</div>
        <div>CI as product authority</div><div class="bad">FORBIDDEN</div>
      </div>
    </article>
  </div>
</section>

<footer>KEX seed: KEX-HTML-LAUNCHPAD-20260819-7F2C91 · self-contained HTML launch surface · no external libraries</footer>
</main>
</div>

<script>
const seed="KEX-HTML-LAUNCHPAD-20260819-7F2C91";
const state={
  bound:false,
  node:{state:"UNOBSERVED",chain:null,verificationprogress:null,ibd:null,bestblockhash:null},
  btc:["NODE_READY","RPC_SYNCED","TEMPLATE_FETCHED","CANDIDATE_ASSEMBLED","HASHING_ACTIVE","NETWORK_TARGET_HIT","SUBMITTED","ACCEPTED_BY_NODE","IN_ACTIVE_CHAIN","COINBASE_MATURED","SPENDABLE"],
  activeIndex:0,
  candidate:{},
  receipts:[]
};
const skills=[
["Story-First Structured Intake","Causal story → correction lineage → typed state → unresolved dependency → experiment → falsification → promotion."],
["KEX Skill Fabric","Discover existing capability before derive; reuse/adapt/bridge before replacement."],
["Proof-Bearing Recursive Engineering","Objective, observable, falsifier, evidence class, readback and next route."],
["Resident Capability Invocation","Invoke existing resident mechanics and retain property-scoped receipts."],
["HTML / HCI","Progressive disclosure, semantic structure, accessibility, explicit state visibility."],
["UI Component Contract","Every control has explicit states and deterministic response semantics."],
["Visual System","Restrained technical hierarchy, readable measure, spacing as relationship."],
["Accessibility","Landmarks, keyboard navigation, focus visibility, reflow and reduced-motion support."],
["Interface Security / Privacy","No credentials in browser; local bridge by default; data-minimised export."],
["Software Lifecycle","Implementation → test → qualification → deployment → readback → maintenance."],
["Research / Innovation","Candidate + falsifier + measure; retain failure rather than narratively erase it."],
["Executable Volume","Addressable state, route, rule, observer, commit order and rehydration."],
["Host / Logical Identity Separation","Node/process/host are manifestations; logical service identity remains separate."],
["Property-Scoped Proof","Never promote whole-system status from a narrower test."],
["Dependency Routing","Blocked live dependencies do not invalidate unrelated implemented layers."]
];
document.querySelectorAll("nav button").forEach(b=>b.addEventListener("click",()=>{
 document.querySelectorAll("nav button").forEach(x=>x.classList.remove("active"));
 document.querySelectorAll("main section").forEach(x=>x.classList.remove("active"));
 b.classList.add("active");document.getElementById(b.dataset.target).classList.add("active");
}));

const resident = {
  linux: {booted:false,mounted:false,rehydrated:false,shell:false},
  volume: {
    address:"kex://volume/btc-core/31.1",
    release:"31.1",
    artifact:null,
    artifact_sha256:null,
    sha256sums_sha256:null,
    signature_receipt:null,
    trusted_fingerprints:[],
    storage_state:"EMPTY",
    rehydration_state:"NOT_ATTEMPTED",
    execution_state:"NOT_STARTED"
  }
};


function makeReceipt(command,status,detail={}){
  return {command,status,at:new Date().toISOString(),...detail};
}
function recordReceipt(r){
  state.receipts.push(r);
  appendLog((r.status.startsWith("PASS")?"PASS ":"")+(r.status.startsWith("BLOCKED")?"BLOCKED ":"")+r.command,r);
  renderResident(); render();
  return r;
}
function linuxProof(){
  return window.__KEX_LINUX_FRESH_BOOT_RECEIPT__ || null;
}
function runShell(cmd){
  cmd=String(cmd||"").trim().toLowerCase();
  const proof=linuxProof();
  const outputs={
    status: proof?.readback?.status || (resident.linux.booted?"status:OK":"status:NOT_BOOTED"),
    ps: proof?.readback?.ps || (resident.linux.booted?"ps:init[1] kex-shell[2]":"ps:NOT_BOOTED"),
    mounts: proof?.readback?.mounts || (resident.linux.mounted?"mounts:resident-volume":"mounts:UNMOUNTED"),
    syscalls: proof?.readback?.syscalls || "syscalls:UNOBSERVED",
    proof: proof?.readback?.proof || "proof:UNOBSERVED",
    help: "status | ps | mounts | syscalls | proof | help"
  };
  const output=outputs[cmd] || "unknown command: "+cmd;
  const el=document.getElementById("residentShellOutput");
  if(el) el.textContent="$ "+cmd+"\n"+output;
  return output;
}
async function residentCommand(name){
  const proof=linuxProof();
  if(name==="LINUX_BOOT"){
    if(globalThis.__KEX_V86_EMULATOR__ && resident.linux.booted){
      return recordReceipt(makeReceipt(name,"PASS_ALREADY_RUNNING",{plane:"real-v86-linux",authority:"emulator-ready"}));
    }
    if(globalThis.KEX_LINUX_FULL_RUNTIME?.bootReal){
      return globalThis.KEX_LINUX_FULL_RUNTIME.bootReal();
    }
    return recordReceipt(makeReceipt(name,"BLOCKED_CONSTRUCTOR",{plane:"real-v86-linux"}));
  }
  if(name==="LINUX_STATUS"){
    if(!resident.linux.booted) return recordReceipt(makeReceipt(name,"BLOCKED_LINUX_NOT_BOOTED"));
    return recordReceipt(makeReceipt(name,"PASS_STATUS_READ",{readback:proof?.readback || {status:"status:OK"}}));
  }
  if(name==="LINUX_MOUNT_VOLUME"){
    if(!resident.linux.booted) return recordReceipt(makeReceipt(name,"BLOCKED_LINUX_NOT_BOOTED"));
    resident.linux.mounted=true;
    return recordReceipt(makeReceipt(name,"PASS_VOLUME_MOUNTED",{address:resident.volume.address}));
  }
  if(name==="LINUX_REHYDRATE"){
    if(!resident.linux.mounted) return recordReceipt(makeReceipt(name,"BLOCKED_VOLUME_NOT_MOUNTED"));
    resident.linux.rehydrated=true;
    resident.volume.rehydration_state="REHYDRATED";
    return recordReceipt(makeReceipt(name,"PASS_REHYDRATED",{storage_state:resident.volume.storage_state}));
  }
  if(name==="LINUX_OPEN_SHELL"){
    if(!resident.linux.booted) return recordReceipt(makeReceipt(name,"BLOCKED_LINUX_NOT_BOOTED"));
    resident.linux.shell=true;
    const input=document.getElementById("residentShellInput");
    if(input) input.focus();
    runShell("status");
    return recordReceipt(makeReceipt(name,"PASS_SHELL_OPEN",{commands:["status","ps","mounts","syscalls","proof","help"]}));
  }
  return recordReceipt(makeReceipt(name,"BLOCKED_UNKNOWN_RESIDENT_ACTION"));
}

function coreReady(){
  return resident.volume.storage_state==="STORED_VERIFIED" &&
         ["CORE_INSTALLED","CORE_RUNNING","RPC_READY"].includes(resident.volume.execution_state);
}
function nodeRunning(){
  return ["RUNNING","SYNCED"].includes(state.node.state);
}
function systemTransition(name){
  if(name==="CHECK_RPC"){
    if(!coreReady()) return makeReceipt(name,"BLOCKED_CORE_NOT_INSTALLED",{required:"verified Bitcoin Core payload + install"});
    if(!nodeRunning()) return makeReceipt(name,"BLOCKED_NODE_NOT_RUNNING");
    return makeReceipt(name,"PASS_RPC_READY",{chain:state.node.chain||"main"});
  }
  if(name==="START_NODE"){
    if(resident.volume.storage_state!=="STORED_VERIFIED")
      return makeReceipt(name,"BLOCKED_CORE_PAYLOAD_NOT_VERIFIED",{storage_state:resident.volume.storage_state});
    resident.volume.execution_state="CORE_RUNNING";
    state.node.state="RUNNING"; state.node.chain="main";
    return makeReceipt(name,"PASS_NODE_STARTED",{network:"mainnet"});
  }
  if(name==="STOP_NODE"){
    if(!nodeRunning()) return makeReceipt(name,"BLOCKED_NODE_NOT_RUNNING");
    state.node.state="STOPPED"; resident.volume.execution_state="CORE_INSTALLED";
    return makeReceipt(name,"PASS_NODE_STOPPED");
  }
  if(name==="GET_BLOCKCHAIN_INFO"){
    if(!nodeRunning()) return makeReceipt(name,"BLOCKED_NODE_NOT_RUNNING");
    return makeReceipt(name,"PASS_CHAIN_STATE_READ",{node:state.node});
  }
  if(name==="REQUEST_TEMPLATE"){
    if(state.node.state!=="SYNCED") return makeReceipt(name,"BLOCKED_NODE_NOT_SYNCED",{node_state:state.node.state});
    state.activeIndex=Math.max(state.activeIndex,2);
    state.candidate.template="OBSERVED";
    return makeReceipt(name,"PASS_TEMPLATE_FETCHED");
  }
  if(name==="RUN_VERTICAL_CLOSURE"){
    if(state.candidate.template!=="OBSERVED") return makeReceipt(name,"BLOCKED_TEMPLATE_NOT_OBSERVED");
    state.activeIndex=Math.max(state.activeIndex,4);
    state.candidate.coinbase="RECONSTRUCTED";
    state.candidate.merkle="RECONSTRUCTED";
    state.candidate.header="RECONSTRUCTED";
    state.candidate.reconstruction="PASS";
    return makeReceipt(name,"PASS_VERTICAL_RECONSTRUCTION");
  }
  if(name==="START_HASHING"){
    if(state.candidate.reconstruction!=="PASS") return makeReceipt(name,"BLOCKED_CANDIDATE_NOT_RECONSTRUCTED");
    state.activeIndex=Math.max(state.activeIndex,4);
    return makeReceipt(name,"PASS_HASHING_STARTED",{boundary:"no target-hit claim"});
  }
  if(name==="STOP_HASHING") return makeReceipt(name,"PASS_HASHING_STOPPED");
  if(name==="SUBMIT_BLOCK"){
    if(state.candidate.target!=="NETWORK HIT") return makeReceipt(name,"BLOCKED_NO_NETWORK_TARGET_HIT");
    return makeReceipt(name,"BLOCKED_LIVE_SUBMIT_REQUIRES_CORE_RECEIPT");
  }
  return makeReceipt(name,"BLOCKED_UNKNOWN_SYSTEM_ACTION");
}

async function command(name){
  // Prefer actual host bridge only when explicitly bound. Otherwise execute deterministic resident state machine.
  if(state.bound){
    const endpoint=document.getElementById("endpoint").value.trim();
    const payload={command:name,seed,authority:"operator"};
    try{
      const r=await fetch(endpoint,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});
      const data=await r.json();
      const receipt=makeReceipt(name,r.ok?"PASS_HOST_RECEIPT":"BLOCKED_HOST_ERROR",{http_status:r.status,data,plane:"host-bridge"});
      applyReadback(data);
      return recordReceipt(receipt);
    }catch(e){
      return recordReceipt(makeReceipt(name,"BLOCKED_BRIDGE_UNREACHABLE",{error:String(e),plane:"host-bridge"}));
    }
  }
  return recordReceipt(systemTransition(name));
}
async function bindRuntime(){
  const endpoint=document.getElementById("endpoint").value.trim();
  if(!endpoint) return recordReceipt(makeReceipt("BIND_RUNTIME","BLOCKED_EMPTY_ENDPOINT"));
  state.bound=true;
  return recordReceipt(makeReceipt("BIND_RUNTIME","PASS_BOUND",{endpoint}));
}
function unbindRuntime(){
  state.bound=false;
  return recordReceipt(makeReceipt("UNBIND_RUNTIME","PASS_UNBOUND"));
}
function installControlDelegation(){
  document.addEventListener("click",e=>{
    const rb=e.target.closest("[data-resident-action]");
    if(rb){ e.preventDefault(); residentCommand(rb.dataset.residentAction); return; }
    const sb=e.target.closest("[data-system-action]");
    if(sb){ e.preventDefault(); command(sb.dataset.systemAction); return; }
    const ub=e.target.closest("[data-ui-action]");
    if(ub){
      e.preventDefault();
      if(ub.dataset.uiAction==="BIND_RUNTIME") bindRuntime();
      else if(ub.dataset.uiAction==="UNBIND_RUNTIME") unbindRuntime();
    }
  });
  const run=document.getElementById("residentShellRun");
  const input=document.getElementById("residentShellInput");
  if(run) run.addEventListener("click",()=>runShell(input?.value||"status"));
  if(input) input.addEventListener("keydown",e=>{if(e.key==="Enter") runShell(input.value);});
}
function applyReadback(data){
 const n=data?.node||data?.runtime?.node;
 if(n){
   state.node.state=n.synced?"SYNCED":(n.state||state.node.state);
   state.node.chain=n.chain||state.node.chain;
   state.node.verificationprogress=n.verificationprogress??state.node.verificationprogress;
   state.node.ibd=n.initialblockdownload??state.node.ibd;
   state.node.bestblockhash=n.bestblockhash||state.node.bestblockhash;
 }
 if(data?.template_received){state.activeIndex=Math.max(state.activeIndex,2);document.getElementById("templateAuthority").textContent="observed";}
 if(data?.candidate_received||data?.reconstruction?.valid){state.activeIndex=Math.max(state.activeIndex,3);}
 if(data?.reconstruction?.valid){state.candidate.reconstruction="PASS";}
 if(data?.submission?.validation?.target_valid){state.activeIndex=Math.max(state.activeIndex,5);state.candidate.target="NETWORK HIT";}
 if(data?.submission?.attempted){state.activeIndex=Math.max(state.activeIndex,6);}
 if(data?.submission?.accepted){state.activeIndex=Math.max(state.activeIndex,7);}
}
installControlDelegation();
renderResident();
render();
</script>


<script id="kex-linux-full-dependency-runtime">
(function(g){
'use strict';

const DB_NAME='KEX_LINUX_ASSET_VOLUME_V1';
const DB_STORE='assets';
const DB_VERSION=1;

const DEP = {
  libv86: {
    key:'libv86.js', kind:'script', required:true,
    localCandidates:['/volume/libv86.js','/runtime/libv86.js','./volume/libv86.js','./runtime/libv86.js'],
    remote:'https://github.com/copy/v86/releases/download/latest/libv86.js',
    sha256:'730d3e4e4bd1d9c7ede4a4995f23da87261a723b3524da9a75c90e6e0610f46b'
  },
  wasm: {
    key:'v86.wasm', kind:'binary', required:true,
    localCandidates:['/volume/v86.wasm','/runtime/v86.wasm','./volume/v86.wasm','./runtime/v86.wasm'],
    remote:'https://github.com/copy/v86/releases/download/latest/v86.wasm',
    sha256:'8a969d64cf8f64b8183fdcc3a2ccdb31ae5ae6db7c9fba49949106f574640a7b'
  },
  bios: {
    key:'seabios.bin', kind:'binary', required:true,
    localCandidates:['/volume/seabios.bin','./volume/seabios.bin'],
    remote:'https://raw.githubusercontent.com/copy/v86/e37189a/bios/seabios.bin'
  },
  vga: {
    key:'vgabios.bin', kind:'binary', required:true,
    localCandidates:['/volume/vgabios.bin','./volume/vgabios.bin'],
    remote:'https://raw.githubusercontent.com/copy/v86/e37189a/bios/vgabios.bin'
  },
  kernel: {
    key:'bzimage-linux.bin', kind:'binary', required:true,
    localCandidates:['/volume/bzimage-linux.bin','./volume/bzimage-linux.bin'],
    remote:'https://i.copy.sh/buildroot-bzimage68.bin'
  },
  initrd: {
    key:'buildroot-linux.bin', kind:'binary', required:true,
    localCandidates:['/volume/buildroot-linux.bin','./volume/buildroot-linux.bin'],
    remote:null
  },
  hda: {
    key:'alpine-root.img', kind:'binary', required:false,
    localCandidates:['/volume/alpine-root.img','./volume/alpine-root.img'],
    remote:null
  }
};

const STATUS={};
const BLOBS={};
const ASSET_EVIDENCE={};
const LINUX_AUTHORITY_STATES=[
  'UNRESOLVED','RESOLVING','VERIFIED_DEPENDENCIES','CONSTRUCTOR_DISPATCH','BOOTING','RUNNING',
  'BLOCKED_HASH_MISMATCH','BLOCKED_UNRESOLVED','BLOCKED_CONSTRUCTOR','BLOCKED_READY_TIMEOUT'
];
function classifyAsset(id,d,patch={}){
  const prior=ASSET_EVIDENCE[id]||{};
  ASSET_EVIDENCE[id]={
    id,key:d?.key||id,
    existence:'PRESENT_DECLARED',
    wiring:'WIRED_IN_RUNTIME',
    resolution:'UNOBSERVED_THIS_PASS',
    integrity:d?.sha256?'HASH_CONTRACT_PRESENT':'HASH_NOT_DECLARED',
    persistence:'INDEXEDDB_ROUTE_WIRED',
    consumed:id==='hda'?'PROVISIONED_OPTIONAL_NOT_REQUIRED':'CONSUMED_WHEN_VERIFIED',
    ...prior,...patch,at:new Date().toISOString()
  };
  return ASSET_EVIDENCE[id];
}
for(const [id,d] of Object.entries(DEP)) classifyAsset(id,d);
let EMULATOR=null;
let DB=null;

function receipt(command,status,detail={}){
  const r={command,status,at:new Date().toISOString(),plane:'linux-dependency-runtime',evidence_scope:'PROPERTY_SCOPED',story_first:true,...detail};
  if(g.state && Array.isArray(g.state.receipts)) g.state.receipts.push(r);
  if(typeof g.appendLog==='function') g.appendLog(command+' '+status,r);
  return r;
}
function render(){
  const body=document.getElementById('linuxDependencyBody');
  if(!body) return;
  const rows=[];
  for(const [id,d] of Object.entries(DEP)){
    const s=STATUS[id]||{state:'PRESENT_DECLARED',source:'DECLARED_ASSET_GRAPH'};
    rows.push(`<tr><td><code>${id}</code>${d.required?' *':''}</td><td>${s.source||'—'}</td><td>${s.state}</td><td>${d.required?'REQUIRED':'OPTIONAL'}</td></tr>`);
  }
  rows.push(`<tr><td><code>screen_container</code> *</td><td>#screen_container</td><td>${document.getElementById('screen_container')?'PRESENT_WIRED':'PRESENT_DECLARED_UNBOUND'}</td><td>REQUIRED</td></tr>`);
  rows.push(`<tr><td><code>terminal_input</code> *</td><td>#terminal-input</td><td>${document.getElementById('terminal-input')?'PRESENT_WIRED':'PRESENT_DECLARED_UNBOUND'}</td><td>REQUIRED</td></tr>`);
  rows.push(`<tr><td><code>terminal_output</code> *</td><td>#terminal-output</td><td>${document.getElementById('terminal-output')?'PRESENT_WIRED':'PRESENT_DECLARED_UNBOUND'}</td><td>REQUIRED</td></tr>`);
  rows.push(`<tr><td><code>memory_size</code> *</td><td>134217728</td><td>RESOLVED</td><td>REQUIRED</td></tr>`);
  rows.push(`<tr><td><code>vga_memory_size</code> *</td><td>8388608</td><td>RESOLVED</td><td>REQUIRED</td></tr>`);
  rows.push(`<tr><td><code>cmdline</code> *</td><td>rw root=rootfs console=ttyS0</td><td>RESOLVED</td><td>REQUIRED</td></tr>`);
  body.innerHTML=rows.join('');
  const b=document.getElementById('linuxRealBoot');
  if(b) b.disabled=!allRequiredResolved();
  const carrier=document.getElementById('linuxCarrierState');
  const volume=document.getElementById('linuxVolumeState');
  if(!EMULATOR && !resident.linux.booted){
    const states=Object.values(STATUS).map(x=>x?.state);
    if(states.includes('BLOCKED_HASH_MISMATCH')) { if(carrier) carrier.textContent='BLOCKED_HASH_MISMATCH'; }
    else if(allRequiredResolved()) { if(carrier) carrier.textContent='VERIFIED_DEPENDENCIES'; if(volume) volume.textContent='VERIFIED_DEPENDENCIES'; }
    else if(states.some(x=>x==='RESOLVING')) { if(carrier) carrier.textContent='RESOLVING'; }
    else { if(carrier) carrier.textContent='UNRESOLVED'; }
  }
}
function allRequiredResolved(){
  return Object.entries(DEP).filter(([,d])=>d.required).every(([id])=>STATUS[id]?.state==='VERIFIED') &&
    !!document.getElementById('screen_container') &&
    !!document.getElementById('terminal-input') &&
    !!document.getElementById('terminal-output');
}
async function sha256(blob){
  const buf=await blob.arrayBuffer();
  const digest=await crypto.subtle.digest('SHA-256',buf);
  return [...new Uint8Array(digest)].map(x=>x.toString(16).padStart(2,'0')).join('');
}
function openDB(){
  return new Promise((resolve,reject)=>{
    const req=indexedDB.open(DB_NAME,DB_VERSION);
    req.onupgradeneeded=()=>{ const db=req.result; if(!db.objectStoreNames.contains(DB_STORE)) db.createObjectStore(DB_STORE); };
    req.onsuccess=()=>resolve(req.result);
    req.onerror=()=>reject(req.error);
  });
}
function dbGet(key){
  return new Promise((resolve,reject)=>{
    const tx=DB.transaction(DB_STORE,'readonly'); const r=tx.objectStore(DB_STORE).get(key);
    r.onsuccess=()=>resolve(r.result||null); r.onerror=()=>reject(r.error);
  });
}
function dbPut(key,val){
  return new Promise((resolve,reject)=>{
    const tx=DB.transaction(DB_STORE,'readwrite'); const r=tx.objectStore(DB_STORE).put(val,key);
    r.onsuccess=()=>resolve(true); r.onerror=()=>reject(r.error);
  });
}
async function fetchBlob(url){
  const r=await fetch(url,{cache:'no-store'});
  if(!r.ok) throw new Error('HTTP '+r.status+' '+url);
  return await r.blob();
}
async function tryCandidates(d){
  const stored=await dbGet(d.key);
  if(stored){
    return {blob:stored,source:'indexeddb://'+DB_NAME+'/'+d.key,state:'STORED'};
  }
  for(const u of d.localCandidates||[]){
    try{
      const blob=await fetchBlob(u);
      if(blob.size) return {blob,source:u,state:'LOCAL'};
    }catch(_){}
  }
  if(d.remote){
    const blob=await fetchBlob(d.remote);
    return {blob,source:d.remote,state:'REMOTE_FIRST_ACQUISITION'};
  }
  throw new Error('No resolved source for '+d.key);
}
async function resolveOne(id,d){
  STATUS[id]={state:'RESOLVING',source:'—'}; render();
  try{
    const got=await tryCandidates(d);
    if(d.sha256){
      const observed=await sha256(got.blob);
      if(observed!==d.sha256) throw new Error('SHA256 mismatch '+id+' observed='+observed);
    }
    BLOBS[id]=got.blob;
    await dbPut(d.key,got.blob);
    STATUS[id]={state:'VERIFIED',source:got.source,size:got.blob.size}; classifyAsset(id,d,{existence:'PRESENT_RESOLVED',resolution:'RESOLVED_THIS_PASS',integrity:d.sha256?'SHA256_VERIFIED_THIS_PASS':'SOURCE_RESOLVED_NO_DECLARED_HASH',persistence:'PERSISTED_INDEXEDDB',source:got.source,size:got.blob.size});
    receipt('LINUX_DEP_'+id.toUpperCase(),'PASS_VERIFIED',{source:got.source,size:got.blob.size});
  }catch(e){
    STATUS[id]={state:d.required?'BLOCKED':'OPTIONAL_UNRESOLVED',source:'DECLARED_ASSET_GRAPH',error:String(e)}; classifyAsset(id,d,{existence:'PRESENT_DECLARED',resolution:'RESOLUTION_BLOCKED_THIS_PASS',error:String(e)});
    receipt('LINUX_DEP_'+id.toUpperCase(),d.required?'BLOCKED_UNRESOLVED':'OPTIONAL_UNRESOLVED',{error:String(e)});
  }
  render();
}
async function resolveAll(){
  DB=DB||await openDB();
  for(const [id,d] of Object.entries(DEP)) await resolveOne(id,d);
  render();
  return receipt('LINUX_DEPENDENCY_RESOLUTION',allRequiredResolved()?'PASS_ALL_REQUIRED':'BLOCKED_REQUIRED_DEPENDENCY',{status:STATUS});
}
function blobURL(id,mime='application/octet-stream'){
  const b=BLOBS[id];
  if(!b) throw new Error('blob missing '+id);
  return URL.createObjectURL(b.type?b:new Blob([b],{type:mime}));
}
async function ensureLib(){
  if(g.V86Starter || g.V86 || g.__KEX_V86_CLASS__) return g.V86Starter||g.V86||g.__KEX_V86_CLASS__;
  const url=blobURL('libv86','text/javascript');
  await new Promise((resolve,reject)=>{
    const s=document.createElement('script'); s.src=url; s.onload=resolve; s.onerror=()=>reject(new Error('libv86 load failed')); document.head.appendChild(s);
  });
  const C=g.V86Starter||g.V86||g.__KEX_V86_CLASS__;
  if(!C) throw new Error('V86 constructor absent after lib load');
  return C;
}
function wireSerial(em){
  const out=document.getElementById('terminal-output');
  const input=document.getElementById('terminal-input');
  let serial='';
  if(em.add_listener){
    em.add_listener('serial0-output-byte',byte=>{
      serial+=String.fromCharCode(byte);
      if(out){ out.textContent=serial; out.scrollTop=out.scrollHeight; }
    });
  }
  if(input){
    input.onkeydown=e=>{
      if(e.key==='Enter'){
        const line=input.value+'\n'; input.value='';
        if(em.serial0_send) em.serial0_send(line);
        else if(em.bus?.send) for(const ch of line) em.bus.send('serial0-input',ch.charCodeAt(0));
      }
    };
  }
}
async function bootReal(){
  if(!allRequiredResolved()){ const e=document.getElementById('linuxCarrierState'); if(e)e.textContent='BLOCKED_UNRESOLVED'; return receipt('LINUX_REAL_BOOT','BLOCKED_UNRESOLVED'); }
  const statusEl=document.getElementById('linuxCarrierState');
  if(statusEl) statusEl.textContent='CONSTRUCTOR_DISPATCH';
  let V86C;
  try { V86C=await ensureLib(); } catch(e) { if(statusEl) statusEl.textContent='BLOCKED_CONSTRUCTOR'; return receipt('LINUX_REAL_BOOT','BLOCKED_CONSTRUCTOR',{error:String(e)}); }
  const screen=document.getElementById('screen_container');
  const cfg={
    wasm_path:blobURL('wasm','application/wasm'),
    memory_size:128*1024*1024,
    vga_memory_size:8*1024*1024,
    screen_container:screen,
    bios:{url:blobURL('bios')},
    vga_bios:{url:blobURL('vga')},
    bzimage:{url:blobURL('kernel')},
    initrd:{url:blobURL('initrd')},
    cmdline:'rw root=rootfs console=ttyS0',
    autostart:true
  };
  if(STATUS.hda?.state==='VERIFIED') cfg.hda={url:blobURL('hda')};
  receipt('LINUX_V86_CONSTRUCTOR_DISPATCH','PASS_DISPATCHED',{config:{...cfg,screen_container:'#screen_container'}});
  EMULATOR=new V86C(cfg); g.__KEX_V86_EMULATOR__=EMULATOR;
  wireSerial(EMULATOR);
  if(statusEl) statusEl.textContent='BOOTING';
  return await new Promise(resolve=>{
    let done=false;
    const finish=(status,detail)=>{
      if(done) return; done=true;
      if(statusEl) statusEl.textContent=status==='PASS_EMULATOR_READY'?'RUNNING':(status==='BLOCKED_READY_TIMEOUT'?'BLOCKED_READY_TIMEOUT':'BLOCKED');
      const r=receipt('LINUX_REAL_BOOT',status,detail); resolve(r);
    };
    if(EMULATOR.add_listener){
      EMULATOR.add_listener('emulator-ready',()=>{
        if(g.resident){
          resident.linux.booted=true; resident.linux.mounted=true; resident.volume.execution_state='REAL_V86_LINUX_RUNNING';
        }
        finish('PASS_EMULATOR_READY',{evidence:'emulator-ready'});
      });
      EMULATOR.add_listener('emulator-stopped',()=>receipt('LINUX_EMULATOR_STOPPED','OBSERVED'));
    }
    setTimeout(()=>finish('BLOCKED_READY_TIMEOUT',{timeout_ms:45000}),45000);
  });
}

async function init(){
  DB=await openDB();
  render();
  document.getElementById('linuxResolveDeps')?.addEventListener('click',resolveAll);
  document.getElementById('linuxRealBoot')?.addEventListener('click',bootReal);
  // Rehydrate on launch but do not use remote network until operator asks Resolve.
  for(const [id,d] of Object.entries(DEP)){
    const stored=await dbGet(d.key);
    if(stored){
      BLOBS[id]=stored;
      if(d.sha256 && await sha256(stored)!==d.sha256){
        STATUS[id]={state:'BLOCKED_HASH_MISMATCH',source:'indexeddb'};
        classifyAsset(id,d,{existence:'PRESENT_PERSISTED',resolution:'REHYDRATED_THIS_PASS',integrity:'BLOCKED_HASH_MISMATCH',persistence:'PERSISTED_INDEXEDDB'});
      }else {
        STATUS[id]={state:'VERIFIED',source:'indexeddb://'+DB_NAME+'/'+d.key,size:stored.size};
        classifyAsset(id,d,{existence:'PRESENT_PERSISTED',resolution:'REHYDRATED_THIS_PASS',integrity:d.sha256?'SHA256_VERIFIED_THIS_PASS':'SOURCE_RESOLVED_NO_DECLARED_HASH',persistence:'PERSISTED_INDEXEDDB',size:stored.size});
      }
    } else STATUS[id]={state:'PRESENT_DECLARED',source:'DECLARED_ASSET_GRAPH'};
  }
  render();
  if(allRequiredResolved()){
    receipt('LINUX_REHYDRATION','PASS_ALL_REQUIRED_FROM_PERSISTENT_VOLUME');
  }
}
g.KEX_LINUX_FULL_RUNTIME={resolveAll,bootReal,status:STATUS,dependencies:DEP,assetEvidence:ASSET_EVIDENCE,authorityStates:LINUX_AUTHORITY_STATES,get emulator(){return EMULATOR;}};
if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',()=>init().catch(e=>receipt('LINUX_RUNTIME_INIT','BLOCKED_INIT_ERROR',{error:String(e)})),{once:true});
else init().catch(e=>receipt('LINUX_RUNTIME_INIT','BLOCKED_INIT_ERROR',{error:String(e)}));
})(globalThis);
</script>


<section class="panel" id="kex-v8-evidence-authority" style="margin-top:18px">
  <h2>V8 — Evidence-Bearing Asset & Runtime Authority</h2>
  <p class="note">Presence, wiring, current-pass resolution, integrity, persistence, execution and readback are separate properties. A current-pass resolution failure never rewrites an established asset to “nonexistent”.</p>
  <div class="grid">
    <div class="card"><div class="label">Asset ontology</div><div class="value">PRESENT → WIRED → RESOLVED → VERIFIED → PERSISTED</div></div>
    <div class="card"><div class="label">Execution ontology</div><div class="value">VERIFIED_DEPENDENCIES → CONSTRUCTOR_DISPATCH → BOOTING → emulator-ready → RUNNING</div></div>
    <div class="card"><div class="label">Historical evidence</div><div class="value">RETAINED / NON-AUTHORITATIVE FOR V86 RUNNING</div></div>
  </div>
  <div style="overflow:auto"><table><thead><tr><th>Asset</th><th>Existence</th><th>Wiring</th><th>Resolution</th><th>Integrity</th><th>Persistence</th><th>Consumption</th></tr></thead><tbody id="kexV8AssetEvidence"></tbody></table></div>
  <pre id="kexV8AuthorityTrace">V8 authority trace initialized.</pre>
</section>
<script id="kex-v8-evidence-authority-runtime">
(function(g){
 function renderV8(){
   const rt=g.KEX_LINUX_FULL_RUNTIME; if(!rt) return;
   const body=document.getElementById('kexV8AssetEvidence'); if(!body) return;
   body.innerHTML=Object.values(rt.assetEvidence||{}).map(a=>`<tr><td><code>${a.key}</code></td><td>${a.existence}</td><td>${a.wiring}</td><td>${a.resolution}</td><td>${a.integrity}</td><td>${a.persistence}</td><td>${a.consumed}</td></tr>`).join('');
   const tr=document.getElementById('kexV8AuthorityTrace');
   if(tr) tr.textContent=JSON.stringify({
     linux_carrier:document.getElementById('linuxCarrierState')?.textContent,
     volume:document.getElementById('linuxVolumeState')?.textContent,
     boot_authority:'V86 emulator-ready only',
     historical_worker_authority:'NON_V86_EXECUTION',
     required_dependencies_verified:Object.entries(rt.dependencies||{}).filter(([,d])=>d.required).every(([id])=>rt.status[id]?.state==='VERIFIED')
   },null,2);
 }
 const old=g.KEX_LINUX_FULL_RUNTIME?.resolveAll;
 if(old) g.KEX_LINUX_FULL_RUNTIME.resolveAll=async function(){const r=await old.apply(this,arguments);renderV8();return r};
 const oldBoot=g.KEX_LINUX_FULL_RUNTIME?.bootReal;
 if(oldBoot) g.KEX_LINUX_FULL_RUNTIME.bootReal=async function(){const r=await oldBoot.apply(this,arguments);renderV8();return r};
 if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',()=>setTimeout(renderV8,50),{once:true}); else setTimeout(renderV8,50);
 g.KEX_V8_RENDER_EVIDENCE=renderV8;
})(globalThis);
</script>

