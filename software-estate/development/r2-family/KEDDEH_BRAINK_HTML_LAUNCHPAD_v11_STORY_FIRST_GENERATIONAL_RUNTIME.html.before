  function recordHistorical(){
    if(typeof state!=='undefined'){
      state.receipts.push({command:'LINUX_HISTORICAL_WORKER_EVIDENCE',plane:'historical-resident-worker',status:'RESIDENT_WORKER_TESTED',at:r.at,receipt:r,authority:'NON_V86_EXECUTION'});
    }
