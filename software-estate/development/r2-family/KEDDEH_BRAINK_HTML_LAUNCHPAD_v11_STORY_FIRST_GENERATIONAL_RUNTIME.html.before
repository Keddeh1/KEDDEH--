<script id="kex-story-first-gen11-code">
(()=>{"use strict";
const INTAKE={"schema":"kex.story-first.intake.v1","seed":"KEX-STORY-FIRST-20260819-GEN11-7F2C91","story":"The launchpad is a materialised HTML carrier of addressable BRAINK/KEX state and constructors. Its job is to preserve and expose existing Universal Library, V86/Linux, evidence, continuation and BTC capabilities, then traverse missing dependencies. It is not a decorative wrapper and must not replace stronger implementations with invented substitutes.","correction_lineage":["v9 already contains Story-First governance, Universal Library planes, adjacent teams, recurrent continuation, V86 dependency/runtime authority and BTC resident invocation.","Prior v10 incorrectly reduced the work to a small appended worker demo instead of letting Story-First identify the first material unresolved dependencies and extending the existing generation graph.","GEN11 therefore preserves v9 literally and adds an evidence-bearing Story-First control plane whose tasks are derived from v9's own unresolved boundaries."],"typed_current_state":{"v9_source":"SOURCE_VERIFIED","story_skill":"SOURCE_VERIFIED","universal_library":"IMPLEMENTED_IN_CARRIER","adjacent_team_fabric":"IMPLEMENTED_IN_CARRIER","historical_linux_worker":"TESTED_NON_V86","fresh_v86_kernel":"NOT_ESTABLISHED","bitcoin_core_live_rpc":"NOT_ESTABLISHED","mainnet_block":"NOT_ESTABLISHED","prior_v10":"SUPERSEDED_AS_DIRECTION"},"capability_resolution":[{"capability":"Story-First intake","decision":"REUSE","source":"KEX-STORY-FIRST-013"},{"capability":"Universal Library generation runtime","decision":"REUSE_ADAPT","source":"v9"},{"capability":"V86 dependency resolver/boot","decision":"REUSE_ADAPT","source":"v9"},{"capability":"adjacent teams","decision":"REUSE_ADAPT","source":"v9"},{"capability":"BTC resident dispatch","decision":"BRIDGE","source":"v9"},{"capability":"live Bitcoin Core authority","decision":"DEPENDENCY_BLOCKED","source":"external/resident authority required"}],"first_material_unresolved_dependencies":["Resolve/verify the real V86 required assets and obtain emulator-ready readback.","Bind resident invocation to an actually executing Bitcoin Core mainnet authority.","Prove Core GBT \u2192 exact candidate \u2192 exact header \u2192 SHA256d \u2192 complete block \u2192 submitblock \u2192 active-chain state without synthetic promotion."],"preserved_invariants":["story remains causal provenance","reuse/adapt/bridge before derive","historical worker evidence cannot promote V86 RUNNING","HTML projection is not Bitcoin consensus authority","mainnet only","exact payout literal retained","no regtest/testnet/signet fallback","target miss is valid mining work, not build failure","Git/repository state is not product state"],"falsifiers":["Any UI state claims V86 RUNNING without emulator-ready.","Any BTC state advances from deterministic/local state without Bitcoin Core receipt.","Any payout address differs from exact literal.","Any regtest/testnet/signet path is selected.","Any new code silently replaces stronger existing v9 capability."],"promotion":"Property-scoped only; implementation candidate until live authorities emit required receipts."};
const GRAPH={"seed":"KEX-STORY-FIRST-20260819-GEN11-7F2C91","btc":{"chain":"main","payout":"bc1qy6ermmqkczhc60qkh6tw53k4uya62w2c85sxh9","forbid":["regtest","testnet","signet"],"fallback":"FORBIDDEN"},"teams":{"TEAM-RUNTIME":["Coordinator","Runtime Gatekeeper","VFS Archivist","Recovery Worker"],"TEAM-EVIDENCE":["Proof Tracer","Falsifier","Independent Verifier","Mirror/Replayer"],"TEAM-ENGINEERING":["Dependency Resolver","Compiler/Builder","Regression Analyst","Integration Worker"],"TEAM-BTC":["BTC State Observer","Fabric Scheduler","Performance Worker","Candidate Validator"],"TEAM-HCI":["HCI Auditor","Accessibility Worker","State Projection Worker","Export Worker"],"TEAM-RESEARCH":["Continuation Governor","Research Falsifier","Skill Extractor","Observer\u00b2 Worker"],"TEAM-PROMOTION":["Promotion Worker","Release Auditor","SBOM/Manifest Worker","Ship Gatekeeper"]},"tasks":[{"id":"SF001","team":"TEAM-EVIDENCE","title":"Preserve causal story and correction lineage","depends":[],"authority":"LOCAL","state":"READY"},{"id":"SF002","team":"TEAM-ENGINEERING","title":"Inventory v9 capabilities before derivation","depends":["SF001"],"authority":"LOCAL","state":"WAITING"},{"id":"SF003","team":"TEAM-RUNTIME","title":"Resolve V86 dependency graph","depends":["SF002"],"authority":"V86","state":"WAITING"},{"id":"SF004","team":"TEAM-RUNTIME","title":"Require emulator-ready for V86 RUNNING","depends":["SF003"],"authority":"V86","state":"WAITING"},{"id":"SF005","team":"TEAM-ENGINEERING","title":"Traverse Universal Library planes and resident addresses","depends":["SF002"],"authority":"LIBRARY","state":"WAITING"},{"id":"SF006","team":"TEAM-RESEARCH","title":"Attach recurrent continuation to evidence relations","depends":["SF001"],"authority":"LOCAL","state":"WAITING"},{"id":"SF007","team":"TEAM-HCI","title":"Project typed states, contradictions and next route","depends":["SF001","SF005"],"authority":"LOCAL","state":"WAITING"},{"id":"SF008","team":"TEAM-BTC","title":"Validate exact mainnet payout invariant","depends":["SF002"],"authority":"LOCAL","state":"WAITING"},{"id":"SF009","team":"TEAM-BTC","title":"Bind resident dispatch to Bitcoin Core mainnet authority","depends":["SF008"],"authority":"BITCOIN_CORE","state":"WAITING"},{"id":"SF010","team":"TEAM-BTC","title":"Observe getblockchaininfo and sync authority","depends":["SF009"],"authority":"BITCOIN_CORE","state":"WAITING"},{"id":"SF011","team":"TEAM-BTC","title":"Observe getblocktemplate from Core","depends":["SF010"],"authority":"BITCOIN_CORE","state":"WAITING"},{"id":"SF012","team":"TEAM-BTC","title":"Reconstruct exact candidate/header and SHA256d boundary","depends":["SF011"],"authority":"BITCOIN_CORE","state":"WAITING"},{"id":"SF013","team":"TEAM-BTC","title":"Run deterministic search without invented target hit","depends":["SF012"],"authority":"BITCOIN_CORE","state":"WAITING"},{"id":"SF014","team":"TEAM-BTC","title":"Submit only qualified complete block","depends":["SF013"],"authority":"BITCOIN_CORE","state":"WAITING"},{"id":"SF015","team":"TEAM-EVIDENCE","title":"Independently read active-chain result","depends":["SF014"],"authority":"BITCOIN_CORE","state":"WAITING"},{"id":"SF016","team":"TEAM-PROMOTION","title":"Evaluate property-scoped promotion","depends":["SF004","SF005","SF006","SF007","SF015"],"authority":"LOCAL","state":"WAITING"}]};
const relations=[];let revision=0;
const byId=id=>GRAPH.tasks.find(t=>t.id===id);
function rec(claim,expected,action,observation,evidence,uncertainty,boundary,next_route){
 const r={seq:relations.length+1,at:new Date().toISOString(),claim,expected_property:expected,action_or_experiment:action,observation,evidence,uncertainty,contradiction:null,proof_scope:"PROPERTY_SCOPED",boundary,next_route};relations.push(r);return r;
}
function deps(t){return t.depends.every(x=>byId(x)?.state==="COMPLETED")}
function runLocal(){
 let progress=true;while(progress){progress=false;for(const t of GRAPH.tasks){if(t.state==="COMPLETED")continue;if(!deps(t)){t.state="WAITING";continue}
 if(t.authority!=="LOCAL"&&t.authority!=="LIBRARY"){t.state="DEPENDENCY_BLOCKED";continue}
 const r=rec(t.title,"bounded task property","reuse/adapt/bridge existing v9 capability","completed local bounded traversal","GEN11-R"+String(relations.length+1).padStart(4,"0"),"live external authority not inferred",t.authority,t.id==="SF005"?"SF006/SF007":"next dependency");
 t.state="COMPLETED";t.receipt="GEN11-R"+String(r.seq).padStart(4,"0");progress=true;
 }}revision++;verify();render();
}
function verify(){
 const f=[];const b=GRAPH.btc;
 if(b.chain!=="main")f.push("CHAIN_NOT_MAIN");if(b.payout!=="bc1qy6ermmqkczhc60qkh6tw53k4uya62w2c85sxh9")f.push("PAYOUT_MUTATED");if(b.payout.includes("..."))f.push("PAYOUT_TRUNCATED");
 if(b.forbid.length!==3||b.fallback!=="FORBIDDEN")f.push("FALLBACK_POLICY");
 const v86=byId("SF004");if(v86?.state==="COMPLETED"&&!globalThis.__KEX_V86_EMULATOR__)f.push("FALSE_V86_PROMOTION");
