[Unit]
Description=KEDDEH Autonomous Spatial Mesh Supervisor
After=network.target local-fs.target
Documentation=https://keddeh.com

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/keddeh/bin/keddeh-mesh-daemon
Restart=always
RestartSec=3s

# Real-Time Scheduling and Hardware Locks
CPUSchedulingPolicy=rr
CPUSchedulingPriority=50
LimitMEMLOCK=infinity
LimitNOFILE=65535

# Isolation & Epistemic Boundaries
RuntimeDirectory=stratum/v2
RuntimeDirectoryMode=0755
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
